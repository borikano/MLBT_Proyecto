root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,json,css,html,java,xml,prisma}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,cmd,bat}]
indent_style = space
indent_size = 4

[*.txt]
trim_trailing_whitespace = false
