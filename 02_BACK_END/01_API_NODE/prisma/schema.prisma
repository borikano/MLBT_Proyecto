generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN_APP
  ADMIN_TIENDA
  MESERO
  COCINA
  BODEGA
  CAJERO
  LECTURA
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

model Usuario {
  id           Int            @id @default(autoincrement())
  nombre       String         @db.VarChar(120)
  username     String         @unique @db.VarChar(60)
  email        String?        @unique @db.VarChar(120)
  passwordHash String         @db.VarChar(255)
  rol          RolUsuario     @default(MESERO)
  estado       EstadoRegistro @default(ACTIVO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ventas       Venta[]

  @@map("usuarios")
}

model ProductoInventario {
  id          Int            @id @default(autoincrement())
  nombre      String         @db.VarChar(150)
  descripcion String?        @db.VarChar(255)
  stock       Decimal        @default(0) @db.Decimal(10, 2)
  unidad      String         @default("unidad") @db.VarChar(40)
  estado      EstadoRegistro @default(ACTIVO)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("productos_inventario")
}

model Venta {
  id        Int       @id @default(autoincrement())
  producto  String    @db.VarChar(150)
  cantidad  Int
  total     Decimal   @db.Decimal(12, 2)
  fecha     DateTime  @default(now())
  usuarioId Int?
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("ventas")
}
